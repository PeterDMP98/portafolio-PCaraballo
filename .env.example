# Groq API Key (gratis - 14,400 requests/día - para el chat)
# Obtén tu key en https://console.groq.com/keys
VITE_GROQ_API_KEY=

# OpenAI API Key (opcional - para el chat)
VITE_OPENAI_API_KEY=

# EmailJS (obligatorio - para el formulario de contacto)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
